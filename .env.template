# ─────────────────────────────────────────────────────────
# .env — Copy this file to .env and fill in your values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────

# ── Slack ──────────────────────────────────────────────
# Get from: api.slack.com/apps → Your App → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here

# Get from: api.slack.com/apps → Your App → Basic Information → Signing Secret
SLACK_SIGNING_SECRET=7a4399d197ebd92f1d368650910b64db

# ── Gmail ──────────────────────────────────────────────
# The Gmail address the bot sends emails FROM
EMAIL_ADDRESS=your-bot-email@gmail.com

# Gmail App Password (not your regular password)
# Generate at: myaccount.google.com → Security → 2-Step → App Passwords
EMAIL_PASSWORD=your-16-char-app-password

# ── Google Sheets ──────────────────────────────────────
# Path to the service account JSON key file you downloaded
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json

# The ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_HERE/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# ── Server ─────────────────────────────────────────────
PORT=3000
